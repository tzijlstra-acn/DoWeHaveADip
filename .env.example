# Environment configuration for dip-or-dca
# Copy to .env and fill in values as needed

# Optional: override default cash rate (annual decimal, e.g. 0.04 = 4%)
# CASH_RATE_OVERRIDE=0.04

# Optional: Streamlit server settings
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true

# Optional: disable live data (use demo fixtures only)
# DEMO_MODE=true
